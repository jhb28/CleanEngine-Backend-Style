package net.junhabaek.springtestexercise.order.presentation;

import com.fasterxml.jackson.annotation.JsonCreator;
import net.junhabaek.springtestexercise.order.application.BuyOrderCommand;

import java.time.LocalDateTime;

public final class BuyOrderRequestDto {
    private BuyOrderRequestDto(){}
    
    public record CreateBuyOrderRequest (
        String ticker,
        Long userId,
        Double size,
        Double price,
        Boolean isMarketOrder
    ){
        @JsonCreator
        public CreateBuyOrderRequest {}

        public BuyOrderCommand.CreateBuyOrder toBuyOrderCommand(LocalDateTime createdAt) {
            return BuyOrderCommand.CreateBuyOrder.builder()
                    .ticker(ticker)
                    .userId(userId)
                    .size(size)
                    .price(price)
                    .isMarketOrder(isMarketOrder)
                    .createdAt(createdAt)
                    .build();
        }
    }
}
